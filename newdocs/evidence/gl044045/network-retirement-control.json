  "ProbeSource": "\"\"\"Private diagnostic overlay; invoke the existing regression driver unchanged.\"\"\"\nimport ctypes\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport sys\nfrom types import SimpleNamespace\n\nctypes.windll.kernel32.SetErrorMode(0x8003)\nRoot = Path('C:/Sandbox/Codex/GL04404520261109')\nSource = Root/'source'\nsys.path.insert(0, str(Source/'tests/runtime'))\nfrom RunQualification import Prepare, Fixtures\nfrom FixtureProcesses import StopAll\n\nHost = Path('C:/Sandbox/Codex/Networking2/benchmark-host-release-standalone/godot.windows.template_release.x86_64.exe')\nLibrary = Path('C:/Sandbox/Codex/Builds/GodotLuau/runtime-msvc-release/godot_luau.dll')\nOutput = Root/sys.argv[1]\nOutput.mkdir(exist_ok=False)\nPrepare(Output, Library)\nFixture = Output/'NetworkIntegration.gd'\nText = Fixture.read_text()\nText = Text.replace('        await Until(\"VictimWaiting\")', '''        await Until(\"VictimWaiting\")\n        Victim.tree_exited.connect(func():\n            Game.set_meta(\"VictimExitedAfterContinuation\", Game.has_meta(\"CancelledInvokeRan\")))\n        BEFORE_FRAME''')\nText = Text.replace('        Victim.queue_free()', '''        Game.set_meta(\"ContinuationBeforeQueue\", Game.has_meta(\"CancelledInvokeRan\"))\n        Victim.queue_free()''')\nText = Text.replace('        BEFORE_FRAME', '        OS.delay_msec(250)' if '--stall' in sys.argv else '        pass')\nText = Text.replace('        if Game.has_meta(\"CancelledInvokeRan\"):', '''        print(\"[Runtime:NetworkDiagnostic] \", JSON.stringify({\"Role\":Role,\"ClientIndex\":ClientIndex,\"CanceledContinuation\":Game.has_meta(\"CancelledInvokeRan\"),\"BeforeQueue\":Game.get_meta(\"ContinuationBeforeQueue\",false),\"BeforeExit\":Game.get_meta(\"VictimExitedAfterContinuation\",false),\"VictimLive\":is_instance_valid(Victim),\"WrongRole\":Game.has_meta(\"WrongRole\")}))\n        if Game.has_meta(\"CancelledInvokeRan\"):''')\nFixture.write_text(Text)\n(Output/'diagnostic-inputs.json').write_text(json.dumps({'Scope':'Diagnostic overlay, not a source correction or accepted qualification','StallMS':250 if '--stall' in sys.argv else 0,'ExtensionSHA256':hashlib.sha256(Library.read_bytes()).hexdigest(),'HostSHA256':hashlib.sha256(Host.read_bytes()).hexdigest(),'FixtureSHA256':hashlib.sha256(Fixture.read_bytes()).hexdigest()},indent=2))\nEnvironment = dict(os.environ, GODOT_SILENCE_ROOT_WARNING='1')\nfor Name in ['APPDATA','LOCALAPPDATA','XDG_CONFIG_HOME','XDG_DATA_HOME','XDG_CACHE_HOME']:\n    Profile = Output/'profile'/Name\n    Profile.mkdir(parents=True)\n    Environment[Name] = str(Profile)\ntry:\n    Results = Fixtures(SimpleNamespace(repeat=1,godot=Host,teardown=True,coordinated_close=True,timeout=60),Output,Environment)\n    (Output/'results.json').write_text(json.dumps(Results,indent=2))\n    print('[Runtime:NetworkDiagnostic] PASS',len(Results),'actors',flush=True)\nfinally:\n    StopAll()\n",
