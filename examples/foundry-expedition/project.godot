config_version=5
[application]
config/name="Foundry Expedition"
run/main_scene="res://Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="GodotLuauFoundryExpedition"
[display]
window/size/viewport_width=1100
window/size/viewport_height=720
[threading]
worker_pool/max_threads=2
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025,0.035,0.06,1)
