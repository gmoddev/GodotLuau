diff --git a/modules/enet/godot_luau_admission.h b/modules/enet/godot_luau_admission.h
new file mode 100644
--- /dev/null
+++ b/modules/enet/godot_luau_admission.h
@@ -0,0 +1,78 @@
+/**************************************************************************/
+/* GodotLuau native data-packet admission adapter. MIT, like the host.       */
+/**************************************************************************/
+#pragma once
+
+#include "core/templates/hash_set.h"
+#include <enet/enet.h>
+
+namespace GodotLuauAdmission {
+constexpr size_t PeerBytes = 4 * 1024 * 1024;
+constexpr size_t PeerCommands = 4096;
+constexpr size_t HostBytes = 16 * 1024 * 1024;
+constexpr size_t HostCommands = 16384;
+
+struct Snapshot {
+	size_t Bytes = 0;
+	size_t Commands = 0;
+	size_t Packets = 0;
+	bool ContainsCandidate = false;
+};
+
+// Same owner thread as ENet service/send. Count full packet ownership, not just
+// remaining fragment lengths: a partly acknowledged packet retains its buffer.
+inline Snapshot ReadPeer(ENetPeer *Peer, const ENetPacket *Candidate = nullptr) {
+	Snapshot Result;
+	HashSet<ENetPacket *> Packets;
+	ENetList *Lists[] = { &Peer->outgoingCommands, &Peer->outgoingSendReliableCommands, &Peer->sentReliableCommands };
+	for (ENetList *List : Lists) {
+		for (ENetListIterator Entry = enet_list_begin(List); Entry != enet_list_end(List); Entry = enet_list_next(Entry)) {
+			const ENetOutgoingCommand *Command = reinterpret_cast<const ENetOutgoingCommand *>(Entry);
+			if (!Command->packet) {
+				continue; // Native control/ACK storage is outside this data-packet cap.
+			}
+			++Result.Commands;
+			Result.ContainsCandidate |= Command->packet == Candidate;
+			if (!Packets.has(Command->packet)) {
+				Packets.insert(Command->packet);
+				Result.Bytes += Command->packet->dataLength;
+				++Result.Packets;
+			}
+		}
+	}
+	return Result;
+}
+
+inline Snapshot ReadHost(ENetHost *Host) {
+	Snapshot Result;
+	for (size_t Index = 0; Index < Host->peerCount; ++Index) {
+		Snapshot Peer = ReadPeer(&Host->peers[Index]);
+		Result.Bytes += Peer.Bytes;
+		Result.Commands += Peer.Commands;
+		Result.Packets += Peer.Packets;
+	}
+	return Result;
+}
+
+inline bool Exceeds(size_t Current, size_t Added, size_t Limit) {
+	return Current > Limit || Added > Limit - Current;
+}
+
+inline bool Allows(ENetPeer *Peer, const ENetPacket *Packet) {
+	size_t Header = sizeof(ENetProtocolHeader) + sizeof(ENetProtocolSendFragment);
+	if (Peer->host->checksum) {
+		Header += sizeof(enet_uint32);
+	}
+	if (Peer->mtu <= Header) {
+		return false;
+	}
+	const size_t FragmentBytes = Peer->mtu - Header;
+	const size_t Commands = Packet->dataLength > FragmentBytes ?
+			1 + (Packet->dataLength - 1) / FragmentBytes : 1;
+	Snapshot Local = ReadPeer(Peer, Packet);
+	Snapshot Host = ReadHost(Peer->host);
+	const size_t Bytes = Local.ContainsCandidate ? 0 : Packet->dataLength;
+	return !Exceeds(Local.Bytes, Bytes, PeerBytes) && !Exceeds(Local.Commands, Commands, PeerCommands) &&
+			!Exceeds(Host.Bytes, Bytes, HostBytes) && !Exceeds(Host.Commands, Commands, HostCommands);
+}
+} // namespace GodotLuauAdmission
