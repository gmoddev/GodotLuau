extends RefCounted

func Run(Runner, Game: Node) -> void:
    var Owner = Runner.CreateScript("ServerScript","NativeAnimationOwner","""
local S=Scene.new(script.Parent)
S.Name='NativeAnimationScope'
local Stage=S:New('Node3D',{Name='Stage'})
local Visual=S:New('MeshInstance3D',{Name='Visual',Mesh=S:New('BoxMesh',{})},Stage)
local Player=S:New('AnimationPlayer',{Name='Player'},Stage)
local Clip=S:New('Animation',{Length=0.1})
local Track=S:Call(Clip,'AddTrack',Scene.Enums.Animation.TrackType.TYPE_VALUE)
S:Call(Clip,'TrackSetPath',Track,'Visual:position')
assert(S:Call(Clip,'TrackGetPath',Track)=='Visual:position')
S:Call(Clip,'TrackInsertKey',Track,0,Vector3.new(0,0,0))
S:Call(Clip,'TrackInsertKey',Track,0.1,Vector3.new(2,0,0))
local Library=S:New('AnimationLibrary',{})
assert(S:Call(Library,'AddAnimation','move',Clip)==0)
assert(S:Call(Library,'GetAnimationList')[1]=='move')
assert(S:Call(Player,'AddAnimationLibrary','',Library)==0)
assert(not pcall(function() S:Call(Clip,'TrackInsertKey',Track,0.05,Vector3.new(99,0,0)) end))
assert(not pcall(function() S:Call(Library,'AddAnimation','another',Clip) end))
local Bad=S:New('Animation',{Length=0.1})
local BadTrack=S:Call(Bad,'AddTrack',0)
S:Call(Bad,'TrackSetPath',BadTrack,'../Foreign:position')
S:Call(Bad,'TrackInsertKey',BadTrack,0,Vector3.new(0,0,0))
local BadLibrary=S:New('AnimationLibrary',{})
S:Call(BadLibrary,'AddAnimation','escape',Bad)
assert(not pcall(function() S:Call(Player,'AddAnimationLibrary','bad',BadLibrary) end))
assert(#S:Call(Player,'GetAnimationList')==1)
assert(not pcall(function() S:Call(Bad,'AddTrack',2) end))
assert(not pcall(function() S:Call(Bad,'TrackInsertKey',0,0.2,1) end))
S:Connect(Player,'AnimationFinished',function(Name)
 assert(Name=='move');game:SetAttribute('NativeAnimation3D',true)
 task.wait(0.2);game:SetAttribute('NativeAnimationStale',true)
end)
local Stage2=S:New('Node2D',{Name='Stage2D'})
local Visual2=S:New('Node2D',{Name='Visual'},Stage2)
local Player2=S:New('AnimationPlayer',{Name='Player'},Stage2)
local Clip2=S:New('Animation',{Length=0.1})
local Track2=S:Call(Clip2,'AddTrack',0)
S:Call(Clip2,'TrackSetPath',Track2,'Visual:position')
S:Call(Clip2,'TrackInsertKey',Track2,0,Scene.Value('Vector2',{X=0,Y=0}))
S:Call(Clip2,'TrackInsertKey',Track2,0.1,Scene.Value('Vector2',{X=20,Y=0}))
local Library2=S:New('AnimationLibrary',{})
S:Call(Library2,'AddAnimation','move',Clip2)
S:Call(Player2,'AddAnimationLibrary','',Library2)
S:Connect(Player2,'AnimationFinished',function(Name) assert(Name=='move');game:SetAttribute('NativeAnimation2D',true) end)
S:Call(Player,'Play','move')
S:Call(Player2,'Play','move')
game:SetAttribute('NativeAnimationReady',true)
""",Game)
    if not await Runner.Until("NativeAnimationReady"):
        return
    await Runner.Until("NativeAnimation3D")
    await Runner.Until("NativeAnimation2D")
    var Scope := Game.get_node("NativeAnimationScope")
    Runner.Check(is_equal_approx((Scope.get_node("Stage/Visual") as Node3D).position.x,2),"Native 3D AnimationPlayer advances an approved owned property")
    Runner.Check(is_equal_approx((Scope.get_node("Stage2D/Visual") as Node2D).position.x,20),"Native 2D AnimationPlayer preserves typed Vector2 keys")
    Owner.queue_free()
    await Runner.process_frame
    await Runner.create_timer(0.25).timeout
    Runner.Check(not is_instance_valid(Scope) and not Game.has_meta("NativeAnimationStale"),"Native animation retirement cancels yielded completion callbacks")
    print("[Runtime:NativeAnimation] PASS")
